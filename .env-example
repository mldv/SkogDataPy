# Rename this file to .env to use it for configurations (environment variables take precedence)

# Absolute path for cache, mirroring the folder structure of the FTP server. Default is {project_root}/cache.
# CACHE=/custom/absolute/path/here

# Never connect to the FTP server: read files from the cache only (e.g. downloaded with an FTP client).
# SKOGDATA_OFFLINE=1
